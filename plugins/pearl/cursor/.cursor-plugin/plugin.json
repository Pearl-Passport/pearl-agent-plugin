{
  "name": "pearl-cursor",
  "version": "0.12.1",
  "description": "Eligible Pearl Reserve and Elite members can discover places, explore their taste and activity, check table availability, and confirm visit or saved-place changes. Creating trips and changing their stops requires Pearl Reserve or above, including Pearl Elite. Features depend on connection permissions.",
  "author": {
    "name": "Pearl LLC",
    "email": "hello@joinpearl.co"
  },
  "homepage": "https://joinpearl.co",
  "repository": "https://github.com/Pearl-Passport/pearl-agent-plugin",
  "license": "MIT",
  "keywords": [
    "pearl",
    "travel",
    "venues",
    "recommendations",
    "friends"
  ],
  "logo": "assets/logo.png",
  "skills": "./skills/",
  "mcpServers": {
    "pearl-cursor": {
      "url": "https://agent.joinpearl.co/mcp",
      "auth": {
        "CLIENT_ID": "pearl-cursor",
        "scopes": [
          "venues:read",
          "profile:read",
          "visits:read",
          "saves:read",
          "friends:read",
          "trips:read",
          "reservations:read",
          "visits:write",
          "saves:write",
          "trips:write"
        ]
      }
    }
  }
}
